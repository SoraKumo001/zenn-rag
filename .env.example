# ==============================================================================
# Zenn 記事 RAG システム 設定
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 共通設定
# ------------------------------------------------------------------------------
# プロバイダの選択: openai | ollama | gemini (省略時はAPIキー等の設定状況から自動判別)
EMBEDDING_PROVIDER=openai

# 接続先エンドポイント (LM Studio や Ollama などのローカル・互換サーバー向け)
BASE_URL=http://localhost:1234/v1

# 埋め込みモデル名
EMBEDDING_MODEL=text-embedding-bge-m3

# APIキー (OpenAI, Gemini等。LM Studio等のローカルサーバーは任意の文字列で動作)
API_KEY=lm-studio

# ------------------------------------------------------------------------------
# 2. 代表的な設定例 (プロバイダ別)
# ------------------------------------------------------------------------------
#
# --- LM Studio (OpenAI互換 / 推奨) ---
# EMBEDDING_PROVIDER=openai
# BASE_URL=http://localhost:1234/v1
# EMBEDDING_MODEL=text-embedding-bge-m3
# API_KEY=lm-studio
#
# --- Ollama (完全ローカル・オフライン) ---
# EMBEDDING_PROVIDER=ollama
# BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
#
# --- 本家 OpenAI API ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# API_KEY=sk-...
#
# --- Google Gemini (https://aistudio.google.com/) ---
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# API_KEY=AIzaSy...
#
# ※ プロバイダ固有の環境変数 (OPENAI_BASE_URL, GEMINI_API_KEY, OLLAMA_BASE_URL 等)
#    による指定も引き続き後方互換性として有効です。

# ------------------------------------------------------------------------------
# 3. Zenn 共通設定
# ------------------------------------------------------------------------------
# 記事URL生成用: https://zenn.dev/[username]/articles/[slug]
ZENN_USERNAME=username

# Vector DB (LanceDB) 保存先ディレクトリ (相対パスまたは絶対パス)
VECTOR_DB_DIR=.vectordb
